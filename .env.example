# Copy these into Vercel's Environment Variables (Project Settings -> Environment Variables).
# Do NOT commit real values.

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret

# --- Google Sheets ---
GOOGLE_SHEET_ID=the-long-id-from-your-sheet-url
# Paste the ENTIRE contents of the service account JSON key file as one line:
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# --- Notion (for the sync cron) ---
NOTION_TOKEN=ntn_or_secret_your-notion-token
# The Roadmap database's default data source (queried via /v1/data_sources, Notion-Version 2025-09-03):
NOTION_DATA_SOURCE_ID=37be7b52-2e84-80d5-83ba-000b350eb5bf

# --- Optional: protect the cron endpoint ---
CRON_SECRET=any-random-string
